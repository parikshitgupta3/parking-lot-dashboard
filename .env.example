# By default the app calls the API same-origin: in development, Vite proxies
# /api/* to the backend (see vite.config.ts), so no CORS is required.
#
# Override the proxy target used by `npm run dev`:
# VITE_API_PROXY_TARGET=http://localhost:8080
#
# Call the backend directly cross-origin instead (requires backend CORS):
# VITE_API_BASE_URL=http://localhost:8080
